# Basics
SPRING_APPLICATION_NAME=bookanear-api
SERVER_PORT=8080
SERVER_ERROR_INCLUDE_MESSAGE=always
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=11MB
JACKSON_TIME_ZONE=UTC
PUBLIC_BASE_URL=http://localhost:8080
REGISTRATION_HOME_URL=http://localhost:5173/
REGISTRATION_FROM_EMAIL=no-reply@example.test
REGISTRATION_TOKEN_HOURS=24
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info
PASSWORD_RESET_MINUTES=30

# SQL Database
DB_URL=jdbc:postgresql://localhost:5433/postgres
DB_USER=postgres
DB_PASSWORD=
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=false
FLYWAY_BASELINE_VERSION=6
FLYWAY_VALIDATE_ON_MIGRATE=true

# NonSQL storage
MEDIA_ENABLED=true
MEDIA_BUCKET=booking
MEDIA_S3_ENDPOINT=
MEDIA_S3_ACCESS_KEY=
MEDIA_S3_SECRET_KEY=
MEDIA_MAX_FILE_BYTES=10485760

# Mailserver
SMTP_HOST=127.0.0.1
SMTP_PORT=11025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false

# Security
JWT_SECRET=
JWT_ISSUER=bookanear-api
JWT_EXPIRATION_MINUTES=10080

# Geocoding
GEOCODING_ENABLED=false
GEOCODING_ENDPOINT=https://nominatim.openstreetmap.org/search
GEOCODING_USER_AGENT=

# Logging
LOG_LEVEL_SPRING_WEB=DEBUG
LOG_LEVEL_SPRING_MVC=DEBUG
LOG_LEVEL_HIKARI=DEBUG
LOG_LEVEL_JDBC=DEBUG
LOG_LEVEL_TRANSACTION=DEBUG

# OpenAPI
SWAGGER_UI_PATH=/swagger-ui.html
SWAGGER_TAGS_SORTER=alpha
SWAGGER_OPERATIONS_SORTER=alpha
OPENAPI_DOCS_PATH=/v3/api-docs

# In-app AI help
AI_HELP_API_KEY=
AI_HELP_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_HELP_MODEL=models/gemini-3.8-flash
